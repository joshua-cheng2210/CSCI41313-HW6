doctype html 
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title my Form
    link(rel="stylesheet", href="/myform.css")
  body
    div.filling-form
      h1 Edit Schedule
      form#updateSchedule-form(scheduleID=scheduleID)
        table
          tr
            th
              label(for="day") Day
            th
              select#day(name="day", required)
                option(value="Sun", selected=(day === 'Sun')) Sunday
                option(value="Mon", selected=(day === 'Mon')) Monday
                option(value="Tue", selected=(day === 'Tue')) Tuesday
                option(value="Wed", selected=(day === 'Wed')) Wednesday
                option(value="Thu", selected=(day === 'Thu')) Thursday
                option(value="Fri", selected=(day === 'Fri')) Friday
                option(value="Sat", selected=(day === 'Sat')) Saturday
          tr 
            th
              label(for="event") Event
            th
              input#event(type="text", pattern="[A-Za-z0-9\\s]+", name="event", title="Event must be alphanumeric", required, value=event)
          tr
            th
              label(for="startTime") Start Time:
            th
              input#startTime(name="startTime", type="time", required, value=start)
          tr
            th
              label(for="endTime") End Time:
            th
              input#endTime(name="endTime", type="time", required, value=end)
          tr
            th
              label(for="location") Event Location (Virtual or Physical):
            th
              input#location(type="text", pattern="[A-Za-z0-9\\s]+", name="location", title="Event must be alphanumeric", required, value=location)
          tr
            th
              label(for="phone") Phone Number:
            th
              input#phone(type="text", name="phone", pattern="[0-9]{10}", title="Phone number must contain 10 digits", required, value=phone)
          tr
            th
              label(for="url") event info URL:
            th
              input#url(type="url", name="url", required, value=url)
          tr
            th
            th
              input.submit-button(type="submit", value="Update Event")
        script(src="/js/updateScheduleForm.js")
